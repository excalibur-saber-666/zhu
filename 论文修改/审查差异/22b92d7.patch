+function segment = local_fixed_fault_segment(start_time, end_time, bias, edge)
+segment = local_empty_fault_segments(1);
+segment.start = start_time;
+segment.end = end_time;
+segment.bias = bias;
+segment.edge = sort(edge(:)');
+segment.bias_model = 'fixed';
