         'An explicit fault did not inject the configured additive range bias.');
 end
 
+% The paper random-NLOS mode samples one bounded positive bias per segment
+% and keeps it as a persistent offset.  The realization is deterministic for
+% a given Monte Carlo seed, changes with the seed, and is injected identically to the
+% cached range stream consumed by all comparison methods.
+random_cfg = stage1_cusum_3f3l_config('quick');
+random_cfg.t_stop = 15;
+random_cfg.seeds = 23;
+random_cfg.fault_enable = true;
+random_cfg.fault_mode = 'segmented_explicit_edges_random_bias';
+random_cfg.fault_segments = [3, 7, 1, 4; ...
+                             8, 12, 2, 5];
+random_cfg.plot_position_results = false;
+random_cfg.verbose = false;
+random_report = main_stage1('ekf', random_cfg);
+random_repeat = main_stage1('ekf', random_cfg);
+random_other_cfg = random_cfg;
+random_other_cfg.seeds = 24;
+random_other = main_stage1('ekf', random_other_cfg);
+random_segments = random_report.fault_schedules{1};
+repeat_segments = random_repeat.fault_schedules{1};
+other_segments = random_other.fault_schedules{1};
+assert(numel(random_segments) == 2 && ...
+    all(arrayfun(@(entry) strcmp(entry.bias_model, 'segment_truncated_gmm'), random_segments)), ...
+    'The stochastic NLOS mode did not resolve the requested random-bias segments.');
+random_healthy = random_report.scenario_results.healthy(1).ekf;
+random_fault = random_report.scenario_results.fault(1).ekf;
+seed_changed = false;
+for segment_index = 1:numel(random_segments)
+    segment = random_segments(segment_index);
+    assert(isequal(segment.bias_samples, repeat_segments(segment_index).bias_samples), ...
+        'The stochastic NLOS realization is not reproducible for a fixed seed.');
+    seed_changed = seed_changed || ...
+        ~isequal(segment.bias_samples, other_segments(segment_index).bias_samples);
+    assert(all(segment.bias_samples >= random_cfg.nlos_gmm_bounds_m(1)) && ...
+        all(segment.bias_samples <= random_cfg.nlos_gmm_bounds_m(2)) && ...
+        max(abs(segment.bias_samples - segment.bias_samples(1))) < 1e-12, ...
+        'A stochastic NLOS segment is not persistent and bounded as configured.');
+    range_delta = squeeze(random_fault.range_error(:, segment.edge(1), segment.edge(2)) - ...
+        random_healthy.range_error(:, segment.edge(1), segment.edge(2)));
+    active = random_fault.range_time >= segment.start & ...
+        random_fault.range_time <= segment.end;
+    assert(numel(range_delta(active)) == numel(segment.bias_samples) && ...
+        max(abs(range_delta(active) - segment.bias_samples)) < 1e-12, ...
+        'The cached stochastic NLOS samples were not injected at the matching epochs.');
+    assert(max(abs(range_delta(~active))) < 1e-12, ...
+        'A stochastic NLOS bias was injected outside its scheduled time window.');
